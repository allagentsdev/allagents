                  "warp:file",
                  "warp:native",
                  "zed:file",
                  "zed:native",
                  "zcode:file",
                  "zcode:native",
                  "zenflow:file",
                  "zenflow:native",
                  "pochi:file",
                  "pochi:native",
                  "adal:file",
                  "adal:native",
                  "claude-code:file",
                  "claude-code:native",
                  "github-copilot:file",
                  "github-copilot:native",
                  "gemini-cli:file",
                  "gemini-cli:native",
                  "droid:file",
